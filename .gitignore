# =========================
# Android / Gradle
# =========================

# Built application files
*.apk
*.aab
*.ap_

# Files for the ART/Dalvik VM
*.dex

# Java class files
*.class

# Generated files
bin/
gen/
out/
build/

# Gradle files
.gradle/
**/build/

# Local configuration file (SDK path, etc)
local.properties

# Proguard folder generated by Eclipse
proguard/

# Log files
*.log

# Android Studio / IntelliJ
.idea/
*.iml
*.ipr
*.iws

# Navigation editor temp files
.navigation/

# Capture folder
captures/

# External native build folder
.externalNativeBuild/
.cxx/

# Keystore files (VERY IMPORTANT)
*.jks
*.keystore

# Google Services (optional – nếu không muốn commit)
# google-services.json

# =========================
# OS-specific files
# =========================
.DS_Store
Thumbs.db
